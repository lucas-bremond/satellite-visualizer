{
  "name": "satellite-visualizer",
  "version": "1.12.0",
  "description": "3D satellite visualization panel.",
  "scripts": {
    "build": "webpack -c ./webpack.config.ts --env production",
    "dev": "webpack -w -c ./webpack.config.ts --env development",
    "test": "jest --watch --onlyChanged",
    "test:ci": "jest --passWithNoTests --maxWorkers 4",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache .",
    "lint:fix": "npm run lint -- --fix && prettier --write --list-different .",
    "format": "npx prettier . --check",
    "format:fix": "npx prettier . --write",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots",
    "server": "docker compose up --build",
    "sign": "npx --yes @grafana/sign-plugin@latest"
  },
  "author": "Lucas Brémond",
  "license": "Apache-2.0",
  "devDependencies": {
    "@babel/core": "^7.21.4",
    "@grafana/eslint-config": "^8.2.0",
    "@grafana/plugin-e2e": "^3.6.1",
    "@grafana/tsconfig": "^2.0.0",
    "@playwright/test": "^1.59.1",
    "@stylistic/eslint-plugin-ts": "^2.9.0",
    "@swc/core": "^1.3.90",
    "@swc/helpers": "^0.5.0",
    "@swc/jest": "^0.2.26",
    "@testing-library/jest-dom": "6.1.4",
    "@testing-library/react": "14.0.0",
    "@types/jest": "^29.5.0",
    "@types/lodash": "^4.14.194",
    "@types/node": "^20.8.7",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.3.0",
    "@typescript-eslint/parser": "^8.3.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^6.7.3",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-jsdoc": "^51.2.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-webpack-plugin": "^5.0.0",
    "fork-ts-checker-webpack-plugin": "^8.0.0",
    "glob": "^10.2.7",
    "html-webpack-plugin": "^5.6.0",
    "html-webpack-tags-plugin": "^3.0.2",
    "identity-obj-proxy": "3.0.0",
    "imports-loader": "^5.0.0",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.5.0",
    "prettier": "^2.8.7",
    "replace-in-file-webpack-plugin": "^1.0.6",
    "sass": "1.63.2",
    "sass-loader": "13.3.1",
    "style-loader": "3.3.3",
    "swc-loader": "^0.2.3",
    "terser-webpack-plugin": "^5.3.10",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.5.4",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4",
    "webpack-livereload-plugin": "^3.0.2",
    "webpack-subresource-integrity": "^5.1.0",
    "webpack-virtual-modules": "^0.6.2"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "browserslist": "^4.28.7",
    "fast-uri": "^3.1.6",
    "flatted": "^3.4.2",
    "form-data": "^4.0.6",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.23",
    "protobufjs": "^7.5.5",
    "serialize-javascript": "^7.0.5",
    "websocket-driver": "^0.7.5",
    "ws": "^8.21.0",
    "@eslint/eslintrc": {
      "js-yaml": "^4.3.2"
    },
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^3.15.2"
    }
  },
  "dependencies": {
    "@emotion/css": "11.10.6",
    "@grafana/data": "^12.2.0",
    "@grafana/i18n": "^12.2.0",
    "@grafana/runtime": "^12.2.0",
    "@grafana/schema": "^12.2.0",
    "@grafana/ui": "^12.2.0",
    "@types/webpack-env": "^1.18.8",
    "cesium": "^1.140.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "resium": "~1.22.0",
    "tslib": "2.5.3"
  },
  "packageManager": "npm@9.8.1"
}
